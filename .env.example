# Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# Base de datos (Docker)
POSTGRES_DB=bodegas_atuel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_un_secreto
POSTGRES_PORT=5433

# API: se conecta con el rol bodegas_api (007_roles.sql), nunca con postgres.
# En Docker esta contraseña se le pone al rol sola, al crear la base.
API_DB_PASSWORD=cambiar_por_otro_secreto

# Solo si la API corre fuera de Docker: dónde está la base.
# 5433 = base en Docker, 5432 = PostgreSQL instalado en Windows.
DB_HOST=localhost
DB_PORT=5433
